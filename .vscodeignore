# The extension ships ONLY the production bundle (dist/) plus README /
# CHANGELOG / LICENSE / media. Everything below is dev, build, or internal
# and is never packaged into the VSIX.

# ── Source & build inputs (we ship dist/ only) ──
src/**
test/**
out/**
node_modules/**

# ── Tooling / config ──
.vscode/**
.vscode-test/**
.vscode-test.mjs
esbuild.js
tsconfig.json
.eslintrc.json
.c8rc.json
.gitignore
.vscodeignore

# ── QA / coverage / CI artifacts ──
coverage/**
.github/**
dist/meta.json
dist/meta.chunk-prettier.json
dist/meta.chunk-guard-js.json
dist/meta.chunk-guard-css.json
dist/meta.chunk-guard-html.json

# ── Dev-only assets & scripts (the .png/.md they PRODUCE are shipped) ──
samples/**
media/**/*.mjs
media/*.mjs
scripts/**

# ── Audit / verification scratch directories ──
# MIRROR of .gitignore, and NOT redundant for the same reason as the secrets
# block below: vsce packages from the working directory, not from git. Every
# adversarial pass drops a _probe*/ directory of fixtures and notes next to
# the sources; `vsce ls` was observed listing _probe_bh/fixture.css,
# fixture.json and NOTES.md among the packaged files, because only the blanket
# **/*.ts rule below happened to keep the rest of such a directory out.
_probe*/**
**/_probe*/**

# ── Repo doc not needed inside the VSIX ──
PUBLISHING.md

# ── Local-only internal working docs (strategy / mining / growth /
#    build reports / vsix archive), consolidated under _internal/. ──
_internal/**
STRUCTURE.md
HANDOFF.md

# ── Secrets & personal data ──
# MIRROR of .gitignore. This block is NOT redundant: vsce packages from the
# working directory, NOT from git, and it never reads .gitignore. Without these
# patterns an untracked local .env holding VSCE_PAT / OVSX_PAT would be baked
# into a published VSIX (verified: `vsce ls` lists such a file while git ignores it).
**/*.env
**/.env*
**/*.pat
**/*.pem
**/*.key
**/*.p12
**/*secret*.json

# ── Misc ──
**/*.map
**/*.ts
**/.DS_Store
**/tsconfig.tsbuildinfo
